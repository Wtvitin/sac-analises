# Copie apenas os nomes necessários e substitua todos os marcadores localmente.
# Nunca versione o arquivo .env real.
DATABASE_URL="postgresql://SEU_USUARIO:SUA_SENHA@localhost:5432/sac_analises?schema=public"
PORT=3333
WEB_ORIGIN="http://localhost:5173"
JWT_SECRET="SUBSTITUA_POR_UM_SEGREDO_FORTE"
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./uploads"
TEMP_UPLOAD_EXPIRY_MINUTES=60
REGISTRATION_ENABLED="false"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
TRUST_PROXY="false"

# Configuração de Object Storage remoto (compatível com S3 / Cloudflare R2 / MinIO)
# S3_BUCKET="SEU_BUCKET_EXEMPLO"
# S3_REGION="us-east-1"
# S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
# S3_ACCESS_KEY_ID="SUA_CHAVE_DE_ACESSO"
# S3_SECRET_ACCESS_KEY="SEU_SEGREDO_DE_ACESSO"

# Configuração de envio de e-mail (Gmail SMTP)
# Obtenha uma senha de app em: https://myaccount.google.com/apppasswords
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_SECURE="true"
# SMTP_USER="seu-email@gmail.com"
# SMTP_PASS="sua-senha-de-app-16-digitos"
# SMTP_FROM="SAC Análises <seu-email@gmail.com>"

# Use estas variáveis somente de forma temporária no PowerShell ao criar o primeiro administrador.
INITIAL_ADMIN_NAME="NOME_DO_ADMINISTRADOR"
INITIAL_ADMIN_EMAIL="EMAIL_DO_ADMINISTRADOR"
INITIAL_ADMIN_PASSWORD="SENHA_FORTE_TEMPORARIA"
